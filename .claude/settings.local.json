{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
        "ANTHROPIC_AUTH_TOKEN": "",
        "ANTHROPIC_API_KEY": "",
        "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
    },
    "permissions": {
        "blockReadsOutsideWorkingDirectories": true,
        "deny": [
            "Read(~/**)",
            "Edit(~/**)",
            "Bash(cd .. *)",
            "Bash(cd ../*)",
            "Read(**/bin/**)",
            "Edit(**/bin/**)",
            "Read(**/obj/**)",
            "Edit(**/obj/**)",
            "Read(**/build/**)",
            "Edit(**/build/**)",
            "Read(**/dist/**)",
            "Edit(**/dist/**)",
            "Read(**/out/**)",
            "Edit(**/out/**)",
            "Read(**/lib/**)",
            "Edit(**/lib/**)",
            "Read(**/.vs/**)",
            "Edit(**/.vs/**)",
            "Read(**/.vscode/**)",
            "Edit(**/.vscode/**)",
            "Read(**/*.esproj.user)",
            "Edit(**/*.esproj.user)",
            "Read(**/*.user)",
            "Edit(**/*.user)",
            "Read(**/backups/**)",
            "Edit(**/backups/**)",
            "Read(**/appsettings.json)",
            "Edit(**/appsettings.json)",
            "Read(**/appsettings.Development.json)",
            "Edit(**/appsettings.Development.json)",
            "Read(**/appsettings.Production.json)",
            "Edit(**/appsettings.Production.json)",
            "Read(**/launchSettings.json)",
            "Edit(**/launchSettings.json)",
            "Read(**/.env)",
            "Edit(**/.env)",
            "Read(**/.env.*)",
            "Edit(**/.env.*)",
            "Read(/SubjectDomainsTools.Client/SubjectDomainsTools.Client/obj/Debug/package.g.props)",
            "Edit(/SubjectDomainsTools.Client/SubjectDomainsTools.Client/obj/Debug/package.g.props)",
            "Read(**/.vitepress/dist/**)",
            "Edit(**/.vitepress/dist/**)",
            "Read(**/.vitepress/cache/**)",
            "Edit(**/.vitepress/cache/**)",
            "Read(**/node_modules/**)",
            "Edit(**/node_modules/**)",
            "Read(**/jspm_packages/**)",
            "Edit(**/jspm_packages/**)"
        ]
    }
}
